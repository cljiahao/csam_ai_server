# General Settings
VITE_ENV_NAME=prod     
VITE_APP_VERSION=${PROJECT_VERSION}
VITE_FEATURE_FLAG_NEW_FEATURE=false     # Disable experimental features in production
VITE_LOG_LEVEL=error    # Only log errors in production

# API Settings
VITE_APP_PORT=${APP_PORT}
VITE_DEV_API_URL=""

# Default Values from .env
VITE_TEST_ITEM=${TEST_ITEM}
VITE_TEST_LOT_NO=${TEST_LOT_NO}